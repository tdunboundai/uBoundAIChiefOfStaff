# Copy to .env and fill in the keys you have. Every bot degrades gracefully
# when a key is missing: the Audit Bot marks that model "no API key
# configured — skipped" instead of failing, so you can run everything with
# a subset of keys (or none at all, against the mock data).

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-pro

XAI_API_KEY=
# XAI_MODEL=grok-4

PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro
